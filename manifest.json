{
    "manifest_version": 3,
    "name": "Flow AI Media Downloader TURBO",
    "version": "5.0.0",
    "description": "High-volume autonomous media generator for Google Flow AI. Turbo pipeline for 1000+ images/videos with 2-5s delays.",
    "permissions": [
        "sidePanel",
        "storage",
        "downloads",
        "activeTab"
    ],
    "host_permissions": [
        "https://flow.google.com/*",
        "https://aistudio.google.com/*",
        "https://labs.google/*",
        "https://labs.google.com/*",
        "https://*.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel/index.html"
    },
    "action": {
        "default_title": "Open Flow AI Downloader",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "Command+Shift+L"
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://flow.google.com/*",
                "https://aistudio.google.com/*",
                "https://labs.google/*",
                "https://labs.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}